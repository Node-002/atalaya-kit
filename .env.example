# Copiar a .env (fuera de git) y completar. NUNCA subir valores reales.
# Mejor aún: mantener el .env real fuera de la carpeta del repositorio.

# --- Modo de la aplicación ---
# demo = bandeja simulada, sin cuentas reales (único modo para el despliegue público)
# gmail = conexión real con Gmail (solo local, usuarios de prueba)
ATALAYA_MODE=demo

# --- IA (clave exclusiva del hackathon, con límite de gasto; revocar el lunes) ---
ANTHROPIC_API_KEY=
ATALAYA_LLM_MODEL=

# --- Google OAuth (credenciales del proyecto en modo de pruebas) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# --- Seguridad de la aplicación ---
# Clave Fernet para cifrar tokens OAuth. Generar con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ATALAYA_FERNET_KEY=
# Clave para firmar la cookie de sesión del panel
ATALAYA_SESSION_SECRET=
# Contraseña del administrador (solo versión conectada)
ATALAYA_ADMIN_PASSWORD=

# --- Almacenamiento ---
ATALAYA_DB_PATH=data/atalaya.db

# --- Explicacion con IA (ver docs/adr/0002) ---
# off | simulated | anthropic. Demo publica usa 'simulated' por defecto; conectado usa 'off'.
ATALAYA_LLM=off
# flagged = solo riesgo medio/alto (barato) | all = todos los correos (detecta mas, cuesta mas)
ATALAYA_LLM_POLICY=flagged

# --- Administracion e invitaciones (ver docs/adr/0003) ---
# Contrasena de la persona que usa el panel (modo gmail). Minimo 12 caracteres.
# Sin ella, el modo gmail NO arranca. (ATALAYA_ADMIN_PASSWORD y ATALAYA_SESSION_SECRET ya estan arriba.)
# URL publica con la que se arman los enlaces de invitacion
ATALAYA_BASE_URL=http://localhost:8000
# Nombre que ve la persona invitada en la pagina de consentimiento
ATALAYA_ORG_NAME=

# --- Acceso de la administracion (ver docs/REVISION_SEGURIDAD.md) ---
# RECOMENDADO: cuentas de Google autorizadas a entrar al panel, separadas por comas.
# Solo letras ASCII normales. NO subas aqui correos reales: va solo en tu .env local.
ATALAYA_ADMIN_EMAILS=
# Opcional: exigir ademas que la cuenta pertenezca a este dominio de Google Workspace
ATALAYA_ADMIN_DOMAIN=
# Opcional: supervisores de SOLO LECTURA (ven panel, historial e informes; no pueden aprobar,
# rechazar, desconectar ni invitar). Mismo inicio de sesion con Google. Misma regla ASCII.
ATALAYA_SUPERVISOR_EMAILS=
# Respaldo opcional (si no se define, no existe el acceso por contrasena)
# ATALAYA_ADMIN_PASSWORD ya figura mas arriba (minimo 12 caracteres)

# --- Avisos de seguridad (intentos de acceso, bloqueos) ---
# Siempre aparecen en el panel. Opcional: correo y/o webhook (Slack, Discord, ntfy...)
ATALAYA_SECURITY_CONTACT=
ATALAYA_ALERT_WEBHOOK=
ATALAYA_SMTP_HOST=
ATALAYA_SMTP_PORT=587
ATALAYA_SMTP_USER=
ATALAYA_SMTP_PASSWORD=
ATALAYA_SMTP_FROM=
# Solo si el servidor esta detras de un proxy propio que anade X-Forwarded-For
ATALAYA_TRUST_PROXY=0
