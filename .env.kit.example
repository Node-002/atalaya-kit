# Kit autoalojado de Atalaya. Copia este archivo a .env.kit (fuera de git) y reemplaza cada CAMBIAR_...
# NUNCA subas .env.kit ni el JSON de Google a un repositorio. Guia: docs/INSTALACION.md
# Claves: mira los comandos al final de este archivo.

# --- Obligatorias ---
# Direccion con la que se abre el panel. HTTPS obligatorio (solo para evaluar en tu equipo: http://localhost:8000).
# Debe coincidir EXACTAMENTE con el dominio de la URI de redireccion registrada en Google.
ATALAYA_BASE_URL=https://CAMBIAR_DOMINIO
# Ruta DENTRO del contenedor del JSON del cliente OAuth de Google (docker-compose.yml ya lo monta ahi). No la cambies.
GOOGLE_CLIENT_SECRETS_FILE=/run/secrets/google_client.json
# Clave que cifra los tokens de Google guardados. GUARDA UNA COPIA APARTE (gestor de contrasenas): sin ella
# los tokens de la base son ilegibles y habria que volver a conectar todos los buzones.
ATALAYA_FERNET_KEY=CAMBIAR_CLAVE_FERNET
# Clave aleatoria (minimo 32 caracteres) que protege las sesiones del panel.
ATALAYA_SESSION_SECRET=CAMBIAR_CLAVE_DE_SESION
# Cuentas de Google (separadas por comas) que pueden entrar al panel como administracion. Solo letras ASCII normales.
ATALAYA_ADMIN_EMAILS=CAMBIAR_admin@tudominio.org

# --- Opcionales ---
# Idioma de los mensajes de arranque del kit y del verificador: es (por defecto) o en.
# ATALAYA_LANG=en
# Si el panel esta detras de Caddy (perfil tls) o de otro proxy PROPIO que agrega X-Forwarded-For: 1.
# Sin proxy (evaluacion en localhost): 0. Con 1 y sin proxy, alguien podria falsear su IP y saltarse el limite de intentos.
ATALAYA_TRUST_PROXY=0
# Respaldo si Google no esta disponible (minimo 12 caracteres). Si no la necesitas, borra la linea.
# ATALAYA_ADMIN_PASSWORD=CAMBIAR_CONTRASENA_LARGA
# Restringe el acceso al panel a cuentas de este dominio de Google Workspace.
# ATALAYA_ADMIN_DOMAIN=tudominio.org
# Supervisores de SOLO LECTURA (separados por comas).
# ATALAYA_SUPERVISOR_EMAILS=
# Nombre de la organizacion que ven las personas al conectar su buzon.
# ATALAYA_ORG_NAME=
# Cada cuantos segundos se consulta el correo (por defecto 60) y maximo de mensajes por consulta (25).
# ATALAYA_POLL_SECONDS=60
# ATALAYA_MAX_MESSAGES=25

# --- Explicacion con IA (APAGADA por defecto) ---
# Si la activas, para cada correo se envia a Anthropic un texto ENMASCARADO (dominio, asunto de max. 200
# caracteres, dominios de enlaces y hasta 1 500 caracteres de texto). Lee docs/POLITICA_PRIVACIDAD.md antes.
# off | anthropic
ATALAYA_LLM=off
# ATALAYA_LLM_POLICY=flagged
# ANTHROPIC_API_KEY=CAMBIAR_CLAVE_DE_ANTHROPIC

# --- Avisos de seguridad (opcionales) ---
# ATALAYA_SECURITY_CONTACT=
# ATALAYA_ALERT_WEBHOOK=

# ===== Como generar las claves (no las pegues en el chat ni en un correo) =====
# Fernet (con Docker, sin instalar nada):
#   docker run --rm python:3.12-slim sh -c "pip install -q cryptography >/dev/null 2>&1 && python -c \"from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())\""
# Sesion (con Docker):
#   docker run --rm python:3.12-slim python -c "import secrets; print(secrets.token_urlsafe(48))"
# Si ya tienes Python 3 en tu equipo:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"   (pip install cryptography)
